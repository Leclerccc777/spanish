<view class="page">
<view wx:if="{{unavailable}}" class="card">没有找到表达任务。</view>
<block wx:else>
<view class="eyebrow">PALABRAS EN ACCIÓN · {{task.level}}</view><view class="title">{{task.title}}</view><view wx:if="{{task.bank}}" class="small body">每组最多 5 个目标词，完成全部组可覆盖本词包。切换前请保存草稿。</view><view wx:if="{{task.bank}}" class="accent-row"><button wx:for="{{siblings}}" wx:key="id" data-id="{{item.id}}" bindtap="group">表达 {{item.number}}</button></view><view class="subtitle">{{task.prompt}}</view>
<view wx:if="{{locked}}" class="note">当前可预览题目。扩展任务需达成前一阶段词汇与课程目标；课内任务按单元解锁；综合任务需完成全部单元。</view>
<view class="card"><view class="list-title">把这些词串起来</view><view wx:for="{{task.targets}}" wx:key="wordId" class="body"><text class="spanish">{{item.label}}</text> · {{item.meaning}}<view class="small">可检查词形：{{item.forms}}</view></view><view wx:if="{{task.recycled}}" class="note">复用前面学过的词：{{task.recycled.label}} · {{task.recycled.meaning}}<view class="small">可检查词形：{{task.recycled.forms}}</view></view></view>
<view class="card"><view class="list-title">搭一个表达框架</view><view wx:for="{{task.outline}}" wx:key="*this" class="body">{{index + 1}}. {{item}}</view><view class="small body">至少 {{task.minimumWords}} 个西语词、{{task.minimumSentences}} 句；每句至少 3 词。{{task.minimumParagraphs ? '用空行分成至少两段。' : ''}}</view><view wx:if="{{task.connectors.length}}" class="small">连接语任选一个：{{task.connectors}}</view></view>
<view class="card"><view class="list-title">用你自己的经历来写</view><textarea class="expression-input" value="{{text}}" bindinput="input" placeholder="先写短句，再把句子连接起来。空行可分段。" maxlength="6000" disabled="{{locked}}" auto-height="{{true}}"></textarea><view class="accent-row"><button wx:for="{{['á','é','í','ó','ú','ü','ñ']}}" wx:key="*this" size="mini" data-char="{{item}}" bindtap="accent" disabled="{{locked}}">{{item}}</button></view><view class="row"><button class="secondary" bindtap="save" disabled="{{locked}}">保存草稿</button><button class="primary" bindtap="submit" disabled="{{locked}}">检查词汇覆盖</button></view></view>
<view wx:if="{{result}}" class="card"><view class="section-title">{{result.complete ? '形式要求已完成 ✓' : '继续补充你的表达'}}</view><view class="small">{{result.wordCount}} 词 · {{result.sentenceCount}} 句 · {{result.paragraphCount}} 段</view><view wx:for="{{result.checks}}" wx:key="label" class="body">{{item.passed ? '✓' : '○'}} {{item.label}}</view><view wx:for="{{result.targets}}" wx:key="wordId" class="small body">{{item.used ? '✓ 已使用' : '待加入'}} {{item.label}}</view><view class="note">本地检查只统计所列词形、句数、词数与连接语；不能判断语法、意思或连贯性，不计作词汇掌握或等级认证。</view><view wx:for="{{task.rubric}}" wx:key="*this" class="small body">{{item}}</view><button class="secondary" bindtap="model">{{showModel ? '收起参考' : task.modelKind === 'scaffold' ? '查看待填写句型框架' : '对照参考范文'}}</button><view wx:if="{{showModel}}" class="body spanish expression-model">{{task.model}}</view></view>
</block>
<button class="ghost" bindtap="back">{{task.bank ? '返回扩展词库' : '返回分级课程'}} →</button>
</view>
