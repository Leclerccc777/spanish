<view class="page"><view wx:if="{{unavailable}}" class="card empty">课程不存在或尚未解锁。<button hover-class="button-press" class="secondary" bindtap="home">回到今日</button></view>
<block wx:else><view class="eyebrow">GRAMÁTICA · A1 入门</view><view class="title">{{lesson.title}}</view><view class="subtitle">{{lesson.summary}}</view><view wx:if="{{lesson.extension}}" class="note">{{lesson.extension}}</view>
<block wx:if="{{phase === 'read'}}"><view class="section-title">先理解</view><view class="card"><view wx:for="{{lesson.rules}}" wx:key="*this" class="body">{{index + 1}}. {{item}}</view></view><view class="section-title">在句子里练习</view><view wx:for="{{lesson.examples}}" wx:key="*this" class="card"><view class="example">{{item[0]}}</view><view class="muted">{{item[1]}}</view><view class="audio-controls"><button class="secondary" hover-class="button-press" bindtap="playAudio" data-text="{{item[0]}}">听发音</button><button class="secondary" hover-class="button-press" bindtap="playAudio" data-rate="0.75" data-text="{{item[0]}}">慢速听</button><button class="ghost" bindtap="stopAudio">停止朗读</button></view></view><view class="section-title">本课参考依据</view><view wx:for="{{references}}" wx:key="sourceId" class="card"><view class="small">{{item.title}}</view><view class="body">{{item.section}}</view><button hover-class="button-press" class="secondary" data-url="{{item.url}}" bindtap="copy">复制参考链接</button></view><view class="small">原创讲解与例句 · 主要语法依据已核对 · 非官方教材</view><button hover-class="button-press" class="primary" bindtap="begin">开始 4 道练习 →</button></block>
<block wx:elif="{{phase === 'quiz'}}"><view class="row body"><view class="pill">练习 {{index}} / {{lesson.questions.length}}</view><view class="small">达标线 75%</view></view><view class="small body">每次重练轮换题组，考查相同知识点。</view><view class="section-title">{{question.prompt}}</view><button hover-class="button-press" wx:for="{{question.options}}" wx:for-index="optionIndex" wx:key="*this" class="choice {{selected !== null && optionIndex === question.answer ? 'correct' : selected === optionIndex ? 'wrong' : ''}}" disabled="{{selected !== null}}" data-index="{{optionIndex}}" bindtap="choose">{{item}}</button><view wx:if="{{selected !== null}}"><view class="feedback"><view>{{correct ? '✓ 答对了' : '再看一下这里'}}</view><view class="body">{{question.explanation}}</view></view><button hover-class="button-press" class="primary" bindtap="next">{{index === lesson.questions.length ? '查看结果' : '下一题 →'}}</button></view></block>
<block wx:else><view class="card empty body"><view class="spanish">{{result.score}}%</view><view class="list-title">{{result.passed ? '¡Muy bien! 本课已达标' : '再练一次，会更清楚'}}</view><view class="body muted">答对 {{result.correct}} / {{result.total}} 题。{{result.passed ? '已计入今日语法目标。' : '本次未计入打卡，错题已收进错题本。'}}</view><view class="body" wx:if="{{summary.checkedIn}}">✓ 今日已自动打卡</view><button hover-class="button-press" class="primary" bindtap="home">回到今日</button><button hover-class="button-press" class="secondary" bindtap="begin">换一组同类题</button></view></block></block>
</view>
