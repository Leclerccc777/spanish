<view class="page">
  <view class="eyebrow">PASO A PASO · A1 → B2</view><view class="title">一层一层，练到能用。</view>
  <block wx:if="{{phase === 'menu'}}">
    <view class="subtitle">每级 3 包。先辨析，再填空和纠错，读一段短文，最后写自己的表达。</view>
    <view class="note">从第 1 包开始，每包 4 题至少答对 3 题，再进入下一包；后续内容可预览。这条补充路线单独保存，不计每日打卡或自动提升等级。</view>
    <view class="level-tabs"><button hover-class="button-press" wx:for="{{['A1','A2','B1','B2']}}" wx:key="*this" class="{{level === item ? 'primary' : 'secondary'}}" data-level="{{item}}" bindtap="select">{{item}}</button></view>
    <view wx:for="{{packs}}" wx:key="id" class="card {{item.unlocked ? '' : 'locked'}}"><view class="row"><view class="pill">{{item.level}} · 第 {{item.number}} 包</view><view class="small">{{item.unlocked ? '可练习' : '可预览'}}</view></view><view class="section-title">{{item.title}}</view><view>{{item.goal}}</view><view class="small body">{{item.bestScore === null ? '尚未练习' : '最佳正确率 ' + item.bestScore + '%'}} · 待订正 {{item.mistakes.length}} 项</view><view wx:for="{{item.mistakes}}" wx:for-item="mistake" wx:key="id" class="small body">{{mistake.title}} · 上次：{{mistake.previousAnswer}}</view><button hover-class="button-press" class="{{item.unlocked ? 'primary' : 'secondary'}}" data-id="{{item.id}}" bindtap="open">{{item.unlocked ? '进入学习包' : '预览与查看前置'}} →</button></view>
  </block>
  <block wx:elif="{{phase === 'read'}}">
    <view class="pill">{{pack.level}} · 第 {{pack.number}} 包</view><view class="section-title">{{pack.title}}</view><view class="subtitle">{{pack.goal}}</view>
    <view wx:if="{{!unlocked}}" class="note">先从第 1 包按顺序练习，前一包“{{previous.title}}”最佳正确率至少 75%。<button hover-class="button-press" class="secondary" bindtap="previous">查看前一包</button></view>
    <view class="card body"><view class="list-title">先理解规则</view><view wx:for="{{pack.rules}}" wx:key="*this" class="body">{{index + 1}}. {{item}}</view><view class="small body">复用旧词：{{pack.recycled}}</view></view>
    <view wx:for="{{pack.examples}}" wx:key="*this" class="card"><view class="example">{{item[0]}}</view><view>{{item[1]}}</view></view>
    <view class="card"><view class="list-title">先读一小段</view><view class="example">{{pack.reading}}</view><view class="small body">词语提示：{{pack.glossary}}</view></view>
    <button hover-class="button-press" class="primary" disabled="{{!unlocked}}" bindtap="begin">开始四步练习 →</button>
    <view class="card body"><view class="list-title">5 · 写自己的表达</view><view class="body">{{pack.output.prompt}}</view><view wx:for="{{pack.output.starters}}" wx:key="*this" class="example">{{item}}</view><textarea class="expression-input" aria-label="个人表达草稿" value="{{text}}" maxlength="3000" disabled="{{!unlocked}}" bindinput="draft" placeholder="先用自己的经历写短句，再按提示连接。"/><view class="accent-row"><button hover-class="button-press" wx:for="{{['á','é','í','ó','ú','ü','ñ','¿','¡']}}" wx:key="*this" data-char="{{item}}" disabled="{{!unlocked}}" bindtap="draftAccent">{{item}}</button></view><button hover-class="button-press" class="primary" disabled="{{!unlocked}}" bindtap="save">保存表达草稿</button><view class="small body">{{dirty ? '修改尚未保存' : saved ? '草稿已保存' : '尚无已保存草稿'}}。此处不自动评分。</view><view class="section-title">自己检查，再修改</view><view wx:for="{{pack.output.rubric}}" wx:key="*this" class="body">○ {{item}}</view><button hover-class="button-press" class="secondary" disabled="{{!unlocked || !saved || dirty || !text}}" bindtap="model">{{showModel ? '收起参考范文' : '对照参考范文'}}</button><view wx:if="{{showModel}}" class="example expression-model">{{pack.output.model}}</view></view>
    <view class="card"><view class="list-title">课程与依据</view><view wx:for="{{references}}" wx:key="section" class="small body">{{item.title}} · {{item.section}}<button hover-class="button-press" class="secondary" data-url="{{item.url}}" bindtap="copy">复制参考链接</button></view><view class="small body">新增短文、题目与范文为原创，待教师审稿；等级是本站练习顺序。</view></view>
  </block>
  <block wx:elif="{{phase === 'quiz'}}">
    <view class="pill">{{pack.level}} · {{position}} / 4</view><view class="section-title">{{question.title}}</view><view wx:if="{{position === 4}}" class="card"><view class="example">{{pack.reading}}</view><view class="small body">{{pack.glossary}}</view></view><view class="body">{{question.prompt}}</view>
    <block wx:if="{{question.kind === 'choice'}}"><button hover-class="button-press" wx:for="{{question.options}}" wx:key="*this" class="choice {{feedback && item === question.answers[0] ? 'correct' : feedback && item === input ? 'wrong' : ''}}" disabled="{{!!feedback}}" data-answer="{{item}}" bindtap="choose">{{item}}</button></block>
    <block wx:else><input class="search" aria-label="西语答案" value="{{input}}" maxlength="500" disabled="{{!!feedback}}" bindinput="input" bindconfirm="submit" placeholder="按题目要求填词或写完整句"/><view class="accent-row"><button hover-class="button-press" wx:for="{{['á','é','í','ó','ú','ü','ñ']}}" wx:key="*this" disabled="{{!!feedback}}" data-char="{{item}}" bindtap="accent">{{item}}</button></view><view class="small">重音与 ñ 要准确；本题只核对指定词形和改写。</view><button hover-class="button-press" wx:if="{{!feedback}}" class="primary" bindtap="submit">检查答案</button></block>
    <view wx:if="{{feedback}}" class="feedback body"><view>{{feedback.correct ? '✓ 答对了' : '再看一下语境和词形'}}</view><view class="example">参考答案：{{feedback.answer}}</view><view>{{feedback.explanation}}</view></view><button hover-class="button-press" wx:if="{{feedback}}" class="primary" bindtap="next">{{position === 4 ? '保存并查看结果' : '下一步 →'}}</button>
  </block>
  <block wx:else><view class="card empty"><view class="spanish">{{result.score}}%</view><view class="section-title">{{result.passed ? '基础练习已达标' : '再巩固一次'}}</view><view>答对 {{result.correct}} / {{result.total}} 题；错项保留在列表，重新练习答对后移除。</view><view class="small body">75% 是本包继续练习的门槛，不能证明语言等级；个人表达需自行检查与反馈。</view><button hover-class="button-press" class="primary" bindtap="output">写自己的表达 →</button><button hover-class="button-press" class="secondary" bindtap="begin">重练四步练习</button><button hover-class="button-press" wx:if="{{result.passed && pack.number < 12}}" class="secondary" bindtap="continuePack">继续下一包 →</button></view></block>
  <button hover-class="button-press" wx:if="{{phase !== 'menu'}}" class="ghost" bindtap="menu">返回分级练习</button><button hover-class="button-press" class="ghost" bindtap="home">回到今日</button>
</view>
