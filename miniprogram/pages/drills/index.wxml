<view class="page">
  <view class="eyebrow">PASO A PASO · A1 → B2</view><view class="title">一层一层，练到能用。</view>
  <block wx:if="{{phase === 'menu'}}">
    <view class="subtitle">每级 3 个核心包 + 3 个巩固包。先辨析，再填空和纠错，读一段短文，最后写自己的表达。</view>
    <view class="note">从核心第 1 包开始，按前置关系继续；每包 4 题至少答对 3 题即可达标；后续内容可预览。这条补充路线单独保存，不计每日打卡或自动提升等级。</view>
    <button hover-class="button-press" class="secondary" bindtap="review">集中订正 · {{wrongCount}} 项 →</button><view class="level-tabs"><button hover-class="button-press" wx:for="{{['A1','A2','B1','B2']}}" wx:key="*this" class="{{level === item ? 'primary' : 'secondary'}}" data-level="{{item}}" bindtap="select">{{item}}</button></view>
    <view wx:for="{{packs}}" wx:key="id" class="card {{item.unlocked ? '' : 'locked'}}"><view class="row"><view class="pill">{{item.level}} · {{item.branch === 'core' ? '核心' : '巩固'}} {{item.levelNumber}}</view><view class="small">{{item.unlocked ? '可练习' : '可预览'}}</view></view><view class="section-title">{{item.title}}</view><view>{{item.goal}}</view><view class="small body">{{item.bestScore === null ? '尚未练习' : '最佳正确率 ' + item.bestScore + '%'}} · 待订正 {{item.mistakes.length}} 项</view><view wx:for="{{item.mistakes}}" wx:for-item="mistake" wx:key="id" class="small body">{{mistake.title}} · 上次：{{mistake.previousAnswer}}</view><button hover-class="button-press" class="{{item.unlocked ? 'primary' : 'secondary'}}" data-id="{{item.id}}" bindtap="open">{{item.unlocked ? '进入学习包' : '预览与查看前置'}} →</button></view>
  </block>
  <block wx:elif="{{phase === 'read'}}">
    <view class="pill">{{pack.level}} · {{pack.branch === 'core' ? '核心' : '巩固'}} {{pack.levelNumber}}</view><view class="section-title">{{pack.title}}</view><view class="subtitle">{{pack.goal}}</view>
    <view wx:if="{{!unlocked}}" class="note">按前置关系练习，前一包“{{previous.title}}”最佳正确率至少 75%。<button hover-class="button-press" class="secondary" bindtap="previous">查看前一包</button></view>
    <view class="card body"><view class="list-title">先想清楚要表达什么</view><view class="body">{{pack.approach}}</view><view wx:for="{{pack.rules}}" wx:key="*this" class="body">{{index + 1}}. {{item}}</view><view class="small body">复用旧词：{{pack.recycled}}</view></view>
    <view wx:for="{{pack.examples}}" wx:key="*this" class="card"><view class="example">{{item[0]}}</view><view>{{item[1]}}</view></view>
    <view class="card"><view class="list-title">先读一小段</view><view class="example">{{pack.reading}}</view><view class="small body">词语提示：{{pack.glossary}}</view><button hover-class="button-press" class="secondary" bindtap="words">{{showWords ? '收起词组解释' : '看词组解释'}}</button><block wx:if="{{showWords}}"><view wx:for="{{pack.words}}" wx:key="*this" class="body"><view class="example">{{item[0]}} · {{item[1]}}</view><view class="small">{{item[2]}}</view></view><view class="small body">回到原文找这三组词，再收起提示重读一次。</view></block><view class="small body">先读西语。读不懂时看大意，再回到原文找对应的句子。</view><button hover-class="button-press" class="secondary" bindtap="meaning">{{showMeaning ? '收起中文大意' : '看中文大意'}}</button><view wx:if="{{showMeaning}}" class="body">{{pack.meaning}}</view></view>
    <button hover-class="button-press" class="primary" disabled="{{!unlocked}}" bindtap="begin">开始四步练习 →</button>
    <view class="card body"><view class="list-title">先开口试一句</view><view class="body">{{pack.transfer}}</view><button hover-class="button-press" class="secondary" bindtap="dialogue">{{showDialogue ? '收起个人对话' : '练一段自己的对话'}}</button><block wx:if="{{showDialogue}}"><view class="body">{{pack.dialogue.scene}}</view><view wx:for="{{pack.dialogue.turns}}" wx:key="*this" class="example body">{{item}}</view><view class="body">{{pack.dialogue.personalize}}</view><view class="list-title body">换个情景，再自己说</view><view class="body">{{pack.newScene.prompt}}</view><view class="small body">说完检查：{{pack.newScene.check}}</view><view class="small body">先补上自己的回答，再收起对话，用自己的话说一遍。可在下方草稿中记下对话或新情景表达；手工自查仍对应原写作任务，不自动评分。</view></block><view class="list-title body">5 · 写自己的表达</view><view class="body">{{pack.output.prompt}}</view><view wx:for="{{pack.output.starters}}" wx:key="*this" class="example">{{item}}</view><textarea class="expression-input" aria-label="个人表达草稿" value="{{text}}" maxlength="3000" disabled="{{!unlocked}}" bindinput="draft" placeholder="先用自己的经历写短句，再按提示连接。"/><view class="accent-row"><button hover-class="button-press" wx:for="{{['á','é','í','ó','ú','ü','ñ','¿','¡']}}" wx:key="*this" data-char="{{item}}" disabled="{{!unlocked}}" bindtap="draftAccent">{{item}}</button></view><button hover-class="button-press" class="primary" disabled="{{!unlocked}}" bindtap="save">保存表达草稿</button><view class="small body">{{dirty ? '修改尚未保存' : saved ? '草稿已保存' : '尚无已保存草稿'}}。保存版本 {{revisions}}，此处不自动评分。</view><button hover-class="button-press" wx:if="{{dirty}}" class="secondary" bindtap="resetDraft">撤销未保存修改</button><button hover-class="button-press" wx:if="{{!dirty && hasPrevious}}" class="secondary" bindtap="revertDraft">恢复上一保存版本</button><view class="section-title">自己检查，再修改</view><view class="small">完成后自行勾选；修改文字并保存后重新自查，不是能力评分。</view><checkbox-group bindchange="checks"><label wx:for="{{rubricRows}}" wx:key="label" class="body"><checkbox value="{{item.index}}" checked="{{item.checked}}" disabled="{{!unlocked || dirty || !saved || !hasText}}"/>{{item.label}}</label></checkbox-group><button hover-class="button-press" class="secondary" disabled="{{!unlocked || !saved || dirty || !text}}" bindtap="model">{{showModel ? '收起参考范文' : '对照参考范文'}}</button><view wx:if="{{showModel}}" class="example expression-model">{{pack.output.model}}</view></view>
    <view class="card"><view class="list-title">课程与依据</view><view wx:for="{{references}}" wx:key="section" class="small body">{{item.title}} · {{item.section}}<button hover-class="button-press" class="secondary" data-url="{{item.url}}" bindtap="copy">复制参考链接</button></view><view class="small body">新增短文、题目与范文为原创，待教师审稿；等级是本站练习顺序。</view></view>
  </block>
  <block wx:elif="{{phase === 'quiz'}}">
    <view class="pill">{{pack.level}} · {{position}} / 4</view><view class="section-title">{{question.title}}</view><view wx:if="{{position === 4}}" class="card"><view class="example">{{pack.reading}}</view><view class="small body">{{pack.glossary}}</view></view><view class="body">{{question.prompt}}</view>
    <button hover-class="button-press" wx:if="{{question.hint && !feedback}}" class="secondary" bindtap="hint">{{showHint ? '收起思路提示' : '需要一点提示'}}</button><view wx:if="{{showHint && !feedback}}" class="note">{{question.hint}}</view>
    <block wx:if="{{question.kind === 'choice'}}"><button hover-class="button-press" wx:for="{{question.options}}" wx:key="*this" class="choice {{feedback && item === question.answers[0] ? 'correct' : feedback && item === input ? 'wrong' : ''}}" disabled="{{!!feedback}}" data-answer="{{item}}" bindtap="choose">{{item}}</button></block>
    <block wx:else><input class="search" aria-label="西语答案" value="{{input}}" maxlength="500" disabled="{{!!feedback}}" bindinput="input" bindconfirm="submit" placeholder="按题目要求填词或写完整句"/><view class="accent-row"><button hover-class="button-press" wx:for="{{['á','é','í','ó','ú','ü','ñ']}}" wx:key="*this" disabled="{{!!feedback}}" data-char="{{item}}" bindtap="accent">{{item}}</button></view><view class="small">重音和 ñ 也是拼写的一部分。可以用重音按钮输入。</view><button hover-class="button-press" wx:if="{{!feedback}}" class="primary" bindtap="submit">检查答案</button></block>
    <view wx:if="{{feedback}}" class="feedback body"><view>{{feedback.correct ? '✓ 答对了' : '再看一下，这句话可以这样说'}}</view><view class="example">参考答案：{{feedback.answer}}</view><view wx:if="{{feedback.attention}}">{{feedback.attention}}</view><view>{{feedback.explanation}}</view></view><button hover-class="button-press" wx:if="{{feedback}}" class="primary" bindtap="next">{{position === 4 ? '保存并查看结果' : '下一步 →'}}</button>
  </block>
  <block wx:else><view class="card empty"><view class="spanish">{{result.score}}%</view><view class="section-title">{{result.passed ? '基础练习已达标' : '再巩固一次'}}</view><view>答对 {{result.correct}} / {{result.total}} 题；错项保留在列表，重新练习答对后移除。</view><view class="small body">75% 是本包继续练习的门槛，不能证明语言等级；个人表达需自行检查与反馈。</view><button hover-class="button-press" class="primary" bindtap="output">写自己的表达 →</button><button hover-class="button-press" class="secondary" bindtap="begin">重练四步练习</button><button hover-class="button-press" wx:if="{{result.passed && nextPack}}" class="secondary" bindtap="continuePack">继续：{{nextPack.title}} →</button></view></block>
  <button hover-class="button-press" wx:if="{{phase !== 'menu'}}" class="ghost" bindtap="menu">返回分级练习</button><button hover-class="button-press" class="ghost" bindtap="home">回到今日</button>
</view>
