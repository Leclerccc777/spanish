<view class="page"><view class="eyebrow">VOCABULARIO</view><view class="title">每个词，都有语境。</view><view class="subtitle">320 个 A1–B2 分级词与表达 · 中文释义 · 原创例句</view>
<button class="secondary" bindtap="bank">进入 6500 词库 →</button>
<button class="primary" bindtap="study">开始词卡复习 →</button>
<button class="secondary" bindtap="quiz">词义与拼写测验 →</button>
<input class="search" placeholder="搜索西语或中文释义" value="{{query}}" bindinput="search" />
<view class="row"><picker range="{{filters}}" value="{{filter}}" bindchange="filter"><view class="pill">{{filters[filter]}} ▾</view></picker><view class="small">{{count}} 个词条</view></view>
<view wx:if="{{!count}}" class="card empty">没有找到这个词，试试其他关键词。</view>
<view wx:for="{{words}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="expand"><view class="row"><view class="list-title">{{item.spanish}}</view><view class="pill">{{item.locked ? '后续单元预览' : item.status}}</view></view><view class="body">{{item.meaning}} <text class="small">· {{item.pos}}</text></view><view wx:if="{{expanded === item.id}}"><view class="divider"></view><view class="example">{{item.example}}</view><view class="muted">{{item.translation}}</view><view class="note" wx:if="{{item.note !== '通用'}}">{{item.note}}</view><view class="small body">{{item.verification.reference}}</view><view class="small">{{item.verification.status === 'reviewed' ? '基础词义与词性已核对' : '新增词条待逐条复核'}} {{item.verification.date}} · 例句为原创</view><button class="secondary" data-url="{{item.dictionaryUrl}}" catchtap="copy">复制官方词条链接</button></view></view>
</view>
