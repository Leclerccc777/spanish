<view class="page"><view class="eyebrow">REPASO · A1 → B2</view><view class="title">把错项练明白。</view>
<block wx:if="{{phase === 'setup'}}"><view class="subtitle">只重练尚未订正的题，保留原学习包的完整作答成绩。</view><view class="level-tabs"><button hover-class="button-press" data-level="" class="{{level === '' ? 'primary' : 'secondary'}}" bindtap="select">全部</button><button hover-class="button-press" wx:for="{{['A1','A2','B1','B2']}}" wx:key="*this" data-level="{{item}}" class="{{level === item ? 'primary' : 'secondary'}}" bindtap="select">{{item}}</button></view><view class="card"><view class="list-title">待订正 {{count}} 项</view><view class="body">每轮最多 12 项；答错本轮再出现一次，首次正确率不因订正而提高。</view><view class="small body">订正仅移除错项，不提升原包最佳分，也不开放下一包。完整包未达标时请回去重练。</view><button hover-class="button-press" class="primary" disabled="{{!count}}" bindtap="begin">开始集中订正 →</button></view></block>
<block wx:elif="{{phase === 'quiz'}}"><view class="pill">{{question.level}} · {{position}} / {{total}}</view><view class="small body">{{question.packTitle}} · {{question.title}}</view><view wx:if="{{question.position === 3}}" class="card"><view class="example">{{question.reading}}</view><view class="small body">{{question.glossary}}</view></view><view class="section-title">{{question.prompt}}</view><block wx:if="{{question.kind === 'choice'}}"><button hover-class="button-press" wx:for="{{question.options}}" wx:key="*this" class="choice {{feedback && item === question.answers[0] ? 'correct' : feedback && item === input ? 'wrong' : ''}}" disabled="{{!!feedback}}" data-answer="{{item}}" bindtap="choose">{{item}}</button></block><block wx:else><input class="search" aria-label="订正答案" value="{{input}}" maxlength="500" disabled="{{!!feedback}}" bindinput="input" bindconfirm="submit" placeholder="填词或写完整改句"/><view class="accent-row"><button hover-class="button-press" wx:for="{{['á','é','í','ó','ú','ü','ñ','¿','¡']}}" wx:key="*this" data-char="{{item}}" disabled="{{!!feedback}}" bindtap="accent">{{item}}</button></view><button hover-class="button-press" wx:if="{{!feedback}}" class="primary" bindtap="submit">检查订正</button></block><view wx:if="{{feedback}}" class="feedback body"><view>{{feedback.correct ? '✓ 答对了，错项已移除' : '再看一下规则，本轮稍后重练'}}</view><view class="example">{{feedback.answer}}</view><view>{{feedback.explanation}}</view></view><button hover-class="button-press" wx:if="{{feedback}}" class="primary" bindtap="next">{{position === total ? '查看订正结果' : '下一项 →'}}</button></block>
<block wx:elif="{{phase === 'result'}}"><view class="card empty"><view class="spanish">{{score}}%</view><view class="section-title">本轮首次正确率</view><view>首次答对 {{firstCorrect}} / {{original}} 项；还剩 {{count}} 项待订正。</view><view class="small body">重练后的正确答案不改变首次统计，原包分数与打卡保持原值。</view><button hover-class="button-press" class="primary" bindtap="setup">再看待订正项</button></view></block>
<block wx:else><view class="card empty">当前范围没有待订正项。</view><button hover-class="button-press" class="secondary" bindtap="setup">查看其他等级</button></block><button hover-class="button-press" class="ghost" bindtap="back">返回分级练习</button><button hover-class="button-press" class="ghost" bindtap="home">回到今日</button></view>
