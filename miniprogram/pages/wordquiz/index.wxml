<view class="page"><view class="eyebrow">PONTE A PRUEBA</view><view class="title">真的记住了吗？</view>
<block wx:if="{{phase === 'setup'}}"><view class="subtitle">{{wrongOnly ? '重练待订正错词' : '用词义选择或西语拼写检验记忆'}}。答对的词计入每日目标。</view><view class="card body"><view class="list-title">选择一种练法</view><button class="{{mode === 'meaning' ? 'primary' : 'secondary'}}" data-mode="meaning" bindtap="mode">看西语，选中文词义</button><button class="{{mode === 'spelling' ? 'primary' : 'secondary'}}" data-mode="spelling" bindtap="mode">看中文，拼西语</button><view class="small body">错词本轮再出现一次，仍答错会保留。首答正确率不因重练而提高。</view><button class="primary" bindtap="begin">开始词汇测验 →</button></view></block>
<block wx:elif="{{phase === 'quiz'}}"><view class="row body"><view class="pill">{{position}} / {{total}}</view><view class="small">{{mode === 'meaning' ? '选择词义' : '注意重音与 ñ'}}</view></view><view class="card body"><view class="spanish">{{question.prompt}}</view><block wx:if="{{mode === 'meaning'}}"><button wx:for="{{question.options}}" wx:key="*this" class="choice {{result && item === result.answer ? 'correct' : selected === item ? 'wrong' : ''}}" disabled="{{!!result}}" data-index="{{index}}" bindtap="choose">{{item}}</button></block><block wx:else><view class="small">{{question.hint}}</view><input class="search" placeholder="输入本词卡所学的西班牙语词形" value="{{input}}" bindinput="input" disabled="{{!!result}}" maxlength="200" bindconfirm="submit" /><view class="accent-row"><button wx:for="{{accents}}" wx:key="*this" data-char="{{item}}" bindtap="accent" disabled="{{!!result}}">{{item}}</button></view><button wx:if="{{!result}}" class="primary" bindtap="submit">检查答案</button><view class="small body">有男女两种词形时，任写一种即可。重音符号和 ñ 必须正确。</view></block><view wx:if="{{result}}" class="feedback body"><view>{{result.correct ? '✓ 答对了' : result.accentHint ? '词形接近，注意重音符号或 ñ' : '再记一遍这个词'}}</view><view class="body">正确答案：{{result.answer}}</view><view class="small body">{{result.explanation}}</view></view></view><button wx:if="{{result}}" class="primary" bindtap="next">{{position === total ? '查看结果' : '下一词 →'}}</button></block>
<block wx:elif="{{phase === 'empty'}}"><view class="card empty body">{{wrongOnly ? '暂无待订正错词。' : '当前词包不存在或尚未解锁。'}}<button class="secondary" bindtap="home">回到今日</button></view></block>
<block wx:else><view class="card empty body"><view class="spanish">{{score}}%</view><view class="list-title">首答正确率</view><view class="body">首次答对 {{firstCorrect}} / {{originalCount}} 个词。错词重练已完成，仍未答对的词保留在错词本。</view><view class="muted body">{{summary.checkedIn ? '✓ 今天已经自动打卡' : '答对词汇已计入今日目标，再完成语法练习。'}}</view><button class="primary" bindtap="home">回到今日</button><button class="secondary" bindtap="again">再练一次</button></view></block>
</view>
