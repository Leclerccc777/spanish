<view class="page"><view class="eyebrow">UN POCO CADA DÍA</view>
<block wx:if="{{!done && word}}"><view class="row body"><view class="pill">词卡 {{position}} / {{total}}</view><view class="small">先回忆，再看答案</view></view><view class="progress-track"><view class="progress-fill" style="width:{{(position - 1) / total * 100}}%"></view></view>
<view class="card"><view class="small">你还记得这个词吗？</view><view class="spanish">{{word.spanish}}</view><view class="small">{{word.pos}}</view><view wx:if="{{audioAvailable}}" class="audio-controls"><button class="secondary" bindtap="playAudio" data-text="{{word.spanish}}">听发音</button><button class="secondary" bindtap="playAudio" data-text="{{word.spanish}}" data-rate="0.75">慢速听</button><button class="ghost" bindtap="stopAudio">停止朗读</button></view><view wx:else class="small body">这个扩展词还没有内置音频。</view><block wx:if="{{revealed}}"><view class="divider"></view><view class="list-title">{{word.meaning}}</view><block wx:if="{{word.bank}}"><view class="small body">中文辅助释义（待复核）</view><view class="example">英文原义：{{word.definition}}</view><view wx:if="{{word.pivot}}" class="small">英中对应词：{{word.pivot}}</view></block><block wx:else><view class="example">{{word.example}}</view><view class="muted">{{word.translation}}</view></block><view wx:if="{{noun}}" class="note">{{noun.singular}} → {{noun.plural}} · {{noun.gender}}<view>{{noun.phrase}} · {{noun.phraseTranslation}}</view><view class="small">新增词形与搭配待教师审稿</view></view><view wx:if="{{word.note !== '通用'}}" class="note">{{word.note}}</view></block><button hover-class="button-press" wx:else class="secondary" bindtap="reveal">查看释义与例句</button></view>
<view wx:if="{{revealed}}"><view class="small">诚实评估记忆，系统会安排下次复习。</view><view class="rating-row"><button hover-class="button-press" class="danger" data-rating="again" bindtap="rate">忘记了</button><button hover-class="button-press" class="secondary" data-rating="remember" bindtap="rate">想起来了</button><button hover-class="button-press" class="primary" data-rating="easy" bindtap="rate">很熟悉</button></view></view><view class="small body">忘记的词本轮再出现一次，并保留为今日待复习。间隔安排是简化规则，不是长期掌握证明。</view></block>
<block wx:else><view class="card empty"><view class="title">¡Muy bien!</view><view class="body">{{unavailable ? '该词组不存在或尚未解锁。' : '这一轮结束了。'}}</view><view class="muted body">{{summary.checkedIn ? '今日目标已完成，已自动打卡。' : '继续完成语法练习，让词汇用起来。'}}</view><button hover-class="button-press" class="primary" bindtap="grammar">去练语法 →</button><button hover-class="button-press" class="secondary" bindtap="restart">再学一轮</button><button hover-class="button-press" class="secondary" bindtap="home">回到今日</button></view></block>
</view>
