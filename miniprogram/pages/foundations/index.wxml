<view class="page"><view class="eyebrow">PRIMEROS PASOS</view><view class="title">先学会第一句话。</view>
<block wx:if="{{phase === 'menu'}}"><view class="subtitle">四个 5–6 分钟小步骤，先建立读音、重音、阴阳性与配合的基础。随时可以回来看。</view><view class="note">第一天：先练第一微课，再记 3–5 个词，说一句 Hola, me llamo… 。之后逐步加入语法与表达，不用一次背完词库。</view><view wx:for="{{lessons}}" wx:key="id" class="card"><view class="row"><view class="list-title">{{index + 1}}. {{item.title}}</view><view class="pill">{{item.passed ? '规则练习达标' : item.minutes + ' 分钟'}}</view></view><view class="body muted">{{item.goal}}</view><button hover-class="button-press" class="primary" data-id="{{item.id}}" bindtap="open">{{item.passed ? '再巩固一次' : '从这里开始'}} →</button></view><button hover-class="button-press" class="secondary" bindtap="year">查看一年 A1 → B1 计划</button></block>
<block wx:elif="{{phase === 'read'}}"><view class="section-title">{{lesson.title}}</view><view class="subtitle">{{lesson.goal}}</view><view class="card"><view wx:for="{{lesson.rules}}" wx:key="*this" class="body">{{index + 1}}. {{item}}</view></view><view wx:for="{{lesson.examples}}" wx:key="*this" class="card"><view class="example">{{item[0]}}</view><view class="muted">{{item[1]}}</view></view><view class="card"><view class="list-title">现在开口试一试</view><view class="body">{{lesson.practice}}</view></view><view class="card"><view class="list-title">本课参考</view><view wx:for="{{references}}" wx:key="sourceId" class="body small">{{item.title}} · {{item.section}}<button hover-class="button-press" class="secondary" data-url="{{item.url}}" bindtap="copy">复制参考链接</button></view></view><button hover-class="button-press" class="primary" bindtap="begin">做 4 道小练习 →</button></block>
<block wx:elif="{{phase === 'quiz'}}"><view class="pill">{{position}} / {{lesson.questions.length}}</view><view class="section-title">{{question.prompt}}</view><button hover-class="button-press" wx:for="{{question.options}}" wx:key="*this" class="choice {{selected !== null && index === question.answer ? 'correct' : selected === index ? 'wrong' : ''}}" disabled="{{selected !== null}}" data-index="{{index}}" bindtap="choose">{{item}}</button><view wx:if="{{selected !== null}}" class="feedback body"><view>{{correct ? '✓ 答对了' : '再看一遍这个规则'}}</view><view class="body">{{question.explanation}}</view></view><button hover-class="button-press" wx:if="{{selected !== null}}" class="primary" bindtap="next">{{position === lesson.questions.length ? '查看结果' : '下一题 →'}}</button></block>
<block wx:else><view class="card empty"><view class="spanish">{{result.score}}%</view><view class="section-title">{{result.passed ? '这一步的规则练习已达标' : '慢慢来，再练一次'}}</view><view class="body">答对 {{result.correct}} / {{result.total}} 题。选择题检查规则知识；口头发音仍需要模仿和反馈。</view><view class="small body">基础课进度单独保存，不计每日词汇或语法打卡。</view><button hover-class="button-press" class="secondary" bindtap="begin">重新练习</button><button hover-class="button-press" class="primary" bindtap="menu">继续下一微课 →</button><button hover-class="button-press" class="secondary" bindtap="study">开始今天的词汇</button></view></block>
<button hover-class="button-press" wx:if="{{phase !== 'menu'}}" class="ghost" bindtap="menu">返回四步入门</button><button hover-class="button-press" class="ghost" bindtap="home">回到今日</button></view>
