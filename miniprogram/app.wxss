page{background:#f8f6f0;color:#263e33;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}
.page{padding:36rpx 32rpx 60rpx}.eyebrow{font-size:22rpx;color:#788276;letter-spacing:3rpx;text-transform:uppercase}.title{font-size:54rpx;line-height:1.3;font-weight:700;margin:14rpx 0}.subtitle{color:#758076;font-size:26rpx}.section-title{font-weight:650;font-size:34rpx;margin:36rpx 0 20rpx}.card{background:#fff;border:1rpx solid #e7e8df;border-radius:28rpx;padding:30rpx;margin-bottom:20rpx}.hero{background:#244c3b;color:#fff;border:0;padding:38rpx}.hero .subtitle{color:#d3dfd3}.hero .title{font-size:46rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.stats{display:flex;gap:16rpx}.stat{flex:1;text-align:center;padding:26rpx 12rpx;background:#fff;border:1rpx solid #e7e8df;border-radius:24rpx}.number{font-size:44rpx;font-weight:700}.label{font-size:23rpx;color:#7c857b}.pill{display:inline-block;font-size:22rpx;padding:6rpx 18rpx;border-radius:30rpx;background:#eef2e8;color:#31513c}.warm{background:#fbeddc;color:#a26a35}.muted{color:#7c857b}.body{margin-top:16rpx}.primary,.secondary,.danger{border-radius:18rpx;font-size:28rpx;line-height:2.9;margin-top:24rpx}.primary{background:#dbe8a5;color:#244c3b;font-weight:650}.secondary{background:#eef2e8;color:#244c3b}.danger{background:#f7e3df;color:#a54838}button::after{border:0}.progress-track{height:12rpx;background:#e9ede4;border-radius:12rpx;margin:20rpx 0;overflow:hidden}.progress-fill{height:100%;background:#719568;border-radius:12rpx}.hero .progress-track{background:#46624e}.hero .progress-fill{background:#dbe8a5}.spanish{font-size:58rpx;font-weight:600;line-height:1.3;margin:28rpx 0}.example{font-size:32rpx;font-weight:550;margin:20rpx 0 8rpx}.divider{height:1rpx;background:#e7e8df;margin:24rpx 0}.choice{background:#fff;border:2rpx solid #e2e6db;border-radius:20rpx;padding:22rpx;margin:18rpx 0;line-height:1.6;text-align:left;font-size:28rpx}.choice.correct{background:#edf5df;border-color:#88a25a}.choice.wrong{background:#fceee8;border-color:#d99b82}.feedback{background:#eef2e8;padding:24rpx;border-radius:20rpx}.locked{opacity:.65}.list-title{font-size:32rpx;font-weight:600}.small{font-size:23rpx;color:#7c857b}.search{background:white;padding:20rpx;border:1rpx solid #e7e8df;border-radius:20rpx;margin:24rpx 0}picker{padding:12rpx 0}.calendar{display:flex;flex-wrap:wrap;gap:10rpx}.day{width:74rpx;text-align:center;padding:12rpx 0;border-radius:14rpx;background:#edf0e8;color:#788276}.day.done{background:#244c3b;color:white}.day.today{border:2rpx solid #8ea05f}.goal-options{display:flex;gap:12rpx}.goal-options button{flex:1;font-size:26rpx}.link{color:#456b48;word-break:break-all}.note{background:#fbeddc;color:#805c35;border-radius:18rpx;padding:20rpx;margin:20rpx 0;font-size:24rpx}.empty{text-align:center;padding:44rpx 20rpx}.rating-row{display:flex;gap:12rpx}.rating-row button{flex:1;font-size:25rpx}.source-header{margin-bottom:16rpx}
.accent-row{display:flex;gap:8rpx;flex-wrap:wrap}.accent-row button{min-width:58rpx;margin:0;padding:0 16rpx;font-size:30rpx;line-height:2;background:#eef2e8;color:#244c3b}
.level-tabs {display:flex;gap:12rpx;margin:30rpx 0;}
.level-tabs button {flex:1;margin:0;padding:0;font-size:26rpx;}
.expression-input {box-sizing:border-box;width:100%;min-height:240rpx;margin:24rpx 0;padding:20rpx;border:2rpx solid #dce1d5;border-radius:16rpx;font-size:30rpx;line-height:1.7;}
.accent-row {display:flex;flex-wrap:wrap;gap:8rpx;margin-bottom:24rpx;}
.accent-row button {margin:0;}
.expression-model {white-space:pre-wrap;line-height:1.8;}
