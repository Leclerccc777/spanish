{
  "name": "hola-spanish",
  "version": "0.1.0",
  "private": true,
  "description": "中文学习者的西班牙语入门微信小程序",
  "scripts": {
    "build": "node scripts/build-web.js",
    "package:html": "node scripts/package-html.js",
    "package:android": "node scripts/package-android.js",
    "dev": "node scripts/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check.js",
    "dev:accounts": "HOLA_ACCOUNT_API=/api HOLA_ENABLE_ACCOUNTS=1 node scripts/server.js",
    "start:accounts": "node server/start.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
